{
  "short_name": "Convo",
  "name": "Convo Private Messenger",
  "description": "Private direct and group messaging for Metanet Client",
  "icons": [
    {
      "src": "/convo-mark.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "start_url": "/",
  "display": "standalone",
  "theme_color": "#0b1512",
  "background_color": "#09100e",
  "metanet": {
    "schemaVersion": 1,
    "groupPermissions": {
      "description": "Private messaging, secure storage, and calls",
      "spendingAuthorization": {
        "amount": 600000,
        "description": "Store encrypted chats and attachments"
      },
      "protocolPermissions": [
        {
          "protocolID": [1, "kvstore"],
          "description": "Write encrypted conversation pages"
        },
        {
          "protocolID": [1, "messagebox"],
          "description": "Send encrypted realtime messages"
        },
        {
          "protocolID": [2, "convo private v2"],
          "counterparty": "self",
          "description": "Protect private conversation keys"
        },
        {
          "protocolID": [2, "server hmac"],
          "counterparty": "self",
          "description": "Authenticate realtime connections"
        },
        {
          "protocolID": [2, "identity resolution"],
          "description": "Resolve public Metanet identity certificates for conversation members"
        }
      ],
      "basketAccess": [
        {
          "basket": "convo private v2",
          "description": "Store private conversation secrets"
        }
      ]
    },
    "counterpartyPermissions": {
      "description": "Private messaging and calls with Metanet peers",
      "protocols": [
        {
          "protocolName": "Convo Messenger",
          "description": "Share group keys with this person"
        },
        {
          "protocolName": "auth message signature",
          "description": "Authenticate messages and calls"
        },
        {
          "protocolName": "3241645161d8",
          "description": "Pay storage and relay services"
        }
      ]
    }
  }
}
